# Template do pgbackrest.conf -- não é usado diretamente. O
# entrypoint-wrapper.sh faz `envsubst` nisto em cada arranque do
# container e grava o resultado em /etc/pgbackrest/pgbackrest.conf.
#
# Porquê gerar em runtime e não deixar isto fixo na imagem: o repositório
# de backup precisa ser trocável (posix local agora, S3/MinIO depois) sem
# rebuild da imagem -- só mudando env vars no docker-compose.yml. O
# pgBackRest já suporta os dois "repo types" nativamente
# (https://pgbackrest.org/configuration.html#section-repository), então
# a "customização" pedida é só isto: gerar o bloco certo a partir de
# PGBACKREST_REPO_TYPE.
#
# A secção [global] fica de fora deste template porque as chaves de
# repo1-* mudam de forma inteira entre posix e s3 (ver
# entrypoint-wrapper.sh, que monta [global] inteiro em bash e concatena
# com o resultado deste template). Aqui só fica a secção da stanza, que é
# igual não importa o tipo de repo.

[${PGBACKREST_STANZA}]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
# Sem isto, o pgBackRest tenta ligar como role "postgres" por default --
# que não existe se POSTGRES_USER for outro nome (ex: "app", como no
# nosso docker-compose.yml). Tem de bater com o valor real de
# POSTGRES_USER do container.
pg1-user=${POSTGRES_USER}
