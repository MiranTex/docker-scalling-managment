# Exemplo mínimo: nginx só encaminha tudo pro grupo. TLS/rate limiting/etc
# entrariam aqui depois. Copie pra nginx.conf se for usar o
# docker-compose.example.yml.
server {
    listen 80;

    location / {
        proxy_pass http://group-demo:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
