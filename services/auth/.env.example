# Obrigatória.
AUTH_DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable

# Servidor HTTP.
AUTH_LISTEN_ADDR=:8080

# Onde persistir a chave RSA de assinatura dos JWT entre restarts (ver
# internal/keystore) -- se não existir, é gerada na primeira vez.
AUTH_SIGNING_KEY_FILE=/var/lib/auth/signing-key.json

# Vão em todo JWT emitido (claims iss/aud) e são conferidos na validação --
# qualquer serviço que valide tokens deste auth service precisa saber
# estes dois valores.
AUTH_ISSUER=auth-service
AUTH_AUDIENCE=base-stack

# Validade dos tokens, em segundos.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# Logs estruturados: LOG_FORMAT=json (default, bom pra agregadores de log)
# ou "text" (mais legível local). LOG_LEVEL: debug, info (default), warn
# ou error.
LOG_FORMAT=json
LOG_LEVEL=info

# Login social -- opcional. Um provider só é habilitado se as três
# variáveis dele estiverem definidas; sem nenhuma, o serviço funciona
# normalmente, só sem login social disponível. Redirect URL precisa bater
# com o que está registado na aplicação OAuth do provider.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URL=https://seu-dominio.example/v1/oauth/google/callback

AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URL=https://seu-dominio.example/v1/oauth/github/callback
