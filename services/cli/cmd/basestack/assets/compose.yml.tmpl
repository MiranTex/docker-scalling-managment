# Gerado pelo basestack -- não editar: é reescrito a cada "basestack up" a
# partir de ~/.basestack/settings.json (ou $BASESTACK_HOME).
#
# Tudo o que é da plataforma tem nomes próprios (basestack-*), para nunca
# partilhar redes, volumes ou chaves com outra instalação no mesmo Docker.
name: basestack

networks:
  # A rede da plataforma (auth, portal, launcher...). O Traefik chega por
  # aqui à API do launcher.
  platform:
    name: basestack-platform
    labels:
      base-stack.managed: "true"
  observability:
    name: basestack-observability
    labels:
      base-stack.managed: "true"
  # Só quem está aqui pode dizer ao Grafana quem é o utilizador (portal e
  # launcher); o gateway fica de fora da whitelist do auth proxy.
  grafana:
    name: basestack-grafana
    ipam:
      config:
        - subnet: 172.31.251.0/24
  # Quem lê a API do Docker (pelo proxy só de leitura) lê o env de todos os
  # containers -- por isso esta rede é interna e só para quem precisa.
  docker-api-ro:
    internal: true

volumes:
  database-data:
  # Os backups antigos do pgBackRest, de antes de irem para o storage --
  # ficam aqui intocados.
  database-backups:
  storage-data:
  auth-signing-key:
  traefik-acme:
  traefik-dynamic:
  prometheus-data:
  loki-data:
  registry-data:

services:
  docker-api-ro:
    restart: unless-stopped
    image: tecnativa/docker-socket-proxy:v0.4.0
    environment:
      CONTAINERS: "1"
      NETWORKS: "1"
      IMAGES: "1"
      INFO: "1"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    mem_limit: 64m
    cpus: 0.25
    networks:
      - docker-api-ro

  traefik:
    restart: unless-stopped
    image: traefik:v3.6.1
    container_name: basestack-traefik
    command:
      - --providers.docker=true
      - --providers.docker.endpoint=tcp://docker-api-ro:2375
      - --providers.docker.exposedByDefault=false
      - --providers.docker.network=basestack-platform
      # Um componente a reiniciar (ex: o launcher num up) fica com a rota e
      # responde 503, em vez de a rota sumir e dar 404 enganador.
      - --providers.docker.allowEmptyServices=true
      # Desistir depressa de uma réplica que não atende (ex: o nó dela
      # morreu): o retry do routing tenta outra.
      - --serversTransport.forwardingTimeouts.dialTimeout=3s
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
{{- if .TLSCertResolver}}
      # Com HTTPS automático, o HTTP só redireciona para HTTPS (passwords e
      # API keys nunca em claro); o desafio do Let's Encrypt continua a
      # passar -- o Traefik trata dele antes.
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
{{- end}}
      - --certificatesresolvers.le.acme.email={{.ACMEEmail}}
      - --certificatesresolvers.le.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.le.acme.httpchallenge.entrypoint=web
      - --certificatesresolvers.le.acme.caserver={{.ACMECAServer}}
      - --accesslog=true
      - --accesslog.format=json
      # As métricas só na rede de observabilidade (o nome traefik-metrics só
      # existe lá): o Traefik está também nas redes dos projetos, e as apps
      # leriam o tráfego de todos.
      - --entrypoints.metrics.address=traefik-metrics:8082
      - --metrics.prometheus=true
      - --metrics.prometheus.entrypoint=metrics
    ports:
      - "{{.HTTPPort}}:80"
      - "{{.HTTPSPort}}:443"
    volumes:
      - traefik-dynamic:/etc/traefik/dynamic:ro
      - traefik-acme:/letsencrypt
      # Certificados servidos por SNI (o do registry); o launcher põe-nos
      # no routing (LAUNCHER_TRAEFIK_CERTIFICATES).
      - ./tls/traefik:/etc/traefik/tls:ro
    labels:
      base-stack.managed: "true"
      prometheus.scrape: "true"
      prometheus.port: "8082"
      prometheus.host: traefik-metrics
    mem_limit: 128m
    cpus: 0.25
    depends_on:
      - docker-api-ro
    networks:
      platform: {}
      docker-api-ro: {}
      observability:
        aliases: [traefik-metrics]

  # O storage da plataforma (SeaweedFS, API do S3): os backups da base e
  # dos addons e a cópia cifrada da configuração. Só na rede da plataforma,
  # por HTTPS com a CA da instalação -- o pgBackRest só fala S3 por HTTPS.
  storage:
    restart: unless-stopped
    image: chrislusf/seaweedfs:4.50
    command:
      - mini
      - -dir=/data
      - -ip=127.0.0.1
      - -ip.bind=0.0.0.0
      - -admin.ui=false
      - -master.telemetry=false
      - -s3.port.https=8443
      - -s3.cert.file=/etc/storage/tls.crt
      - -s3.key.file=/etc/storage/tls.key
    environment:
      AWS_ACCESS_KEY_ID: "{{.Secrets.StorageAccessKey}}"
      AWS_SECRET_ACCESS_KEY: "{{.Secrets.StorageSecretKey}}"
      S3_BUCKET: "database,addon-backups,config"
      # As portas internas (filer, volumes) só com tokens assinados.
      WEED_JWT_SIGNING_KEY: "{{.Secrets.StorageJWTKey}}-volume"
      WEED_JWT_SIGNING_READ_KEY: "{{.Secrets.StorageJWTKey}}-volume-read"
      WEED_JWT_FILER_SIGNING_KEY: "{{.Secrets.StorageJWTKey}}-filer"
      WEED_JWT_FILER_SIGNING_READ_KEY: "{{.Secrets.StorageJWTKey}}-filer-read"
      GOMEMLIMIT: 300MiB
    labels:
      base-stack.managed: "true"
    volumes:
      - storage-data:/data
      - ./tls/storage/{{.TLS.StorageCert}}:/etc/storage/tls.crt:ro
      - ./tls/storage/{{.TLS.StorageKey}}:/etc/storage/tls.key:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8333/healthz >/dev/null"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 20s
    mem_limit: 384m
    cpus: 0.5
    networks:
      platform:
        aliases: [basestack-storage]

  database:
    restart: unless-stopped
    image: {{image "database"}}
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: "{{.Secrets.DatabasePassword}}"
      PGBACKREST_STANZA: basestack
      # Os backups (e o WAL) vão para o bucket database do storage.
      PGBACKREST_REPO_TYPE: s3
      BACKUP_S3_ENDPOINT: storage
      BACKUP_S3_PORT: "8443"
      BACKUP_S3_URI_STYLE: path
      BACKUP_S3_BUCKET: database
      BACKUP_S3_REGION: us-east-1
      BACKUP_S3_KEY: "{{.Secrets.StorageAccessKey}}"
      BACKUP_S3_KEY_SECRET: "{{.Secrets.StorageSecretKey}}"
      BACKUP_S3_CA_FILE: /etc/basestack/ca.crt
      AUTH_SERVICE_URL: "http://auth:8080"
      AUTH_ISSUER: "auth.base-stack.local"
      AUTH_AUDIENCE: "base-stack"
      DBADMIN_PROVISIONED_DB_HOST: database
      DBADMIN_PROVISIONED_DB_PORT: "5432"
      DBADMIN_PROVISIONED_DB_SSLMODE: disable
    labels:
      base-stack.managed: "true"
    volumes:
      - database-data:/var/lib/postgresql/data
      - database-backups:/var/lib/pgbackrest
      - ./config/db-init:/docker-entrypoint-initdb.d:ro
      - ./tls/ca.crt:/etc/basestack/ca.crt:ro
    depends_on:
      storage:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 5s
      timeout: 3s
      retries: 5
    mem_limit: 512m
    cpus: 1.0
    networks:
      platform:
        aliases: [basestack-database]

  auth:
    restart: unless-stopped
    image: {{image "auth"}}
    environment:
      AUTH_DATABASE_URL: "postgres://auth:{{.Secrets.AuthDBPassword}}@database:5432/app?sslmode=disable"
      AUTH_ISSUER: "auth.base-stack.local"
      AUTH_AUDIENCE: "base-stack"
      LOG_FORMAT: "json"
      LOG_LEVEL: "info"
      # Promove esta conta a super-admin num arranque do auth, se ela já
      # existir e ainda não houver nenhum -- ver "basestack restart auth".
      AUTH_BOOTSTRAP_SUPERADMIN_EMAIL: "{{.AdminEmail}}"
      # 2FA (obrigatório para os administradores da plataforma): a chave
      # que cifra os segredos, e o nome que aparece na app autenticadora.
      AUTH_MFA_KEY: "{{.Secrets.MFAKey}}"
      AUTH_MFA_ISSUER: "base-stack ({{.Domain}})"
      # false: o 2FA fica opcional também para os admins (desenvolvimento).
      AUTH_MFA_REQUIRED: "{{if .MFAOptional}}false{{else}}true{{end}}"
    labels:
      base-stack.managed: "true"
    volumes:
      - auth-signing-key:/var/lib/auth
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8080/readyz"]
      interval: 5s
      timeout: 3s
      retries: 10
    depends_on:
      database:
        condition: service_healthy
    mem_limit: 128m
    cpus: 0.5
    networks:
      platform:
        aliases: [basestack-auth]

  secretsadmin:
    restart: unless-stopped
    image: {{image "secretsadmin"}}
    environment:
      SECRETSADMIN_DATABASE_URL: "postgres://secretsadmin:{{.Secrets.SecretsadminDBPassword}}@database:5432/app?sslmode=disable"
      AUTH_SERVICE_URL: "http://auth:8080"
      AUTH_ISSUER: "auth.base-stack.local"
      AUTH_AUDIENCE: "base-stack"
      SECRETS_MASTER_KEY: "{{.Secrets.SecretsMasterKey}}"
    labels:
      base-stack.managed: "true"
    depends_on:
      database:
        condition: service_healthy
    mem_limit: 128m
    cpus: 0.25
    networks:
      platform:
        aliases: [basestack-secretsadmin]

  templatesadmin:
    restart: unless-stopped
    image: {{image "templatesadmin"}}
    environment:
      TEMPLATESADMIN_DATABASE_URL: "postgres://templatesadmin:{{.Secrets.TemplatesadminDBPassword}}@database:5432/app?sslmode=disable"
      DOCKER_SOCKET: "tcp://docker-api-ro:2375"
      AUTH_SERVICE_URL: "http://auth:8080"
      AUTH_ISSUER: "auth.base-stack.local"
      AUTH_AUDIENCE: "base-stack"
    labels:
      base-stack.managed: "true"
    depends_on:
      database:
        condition: service_healthy
      docker-api-ro:
        condition: service_started
    mem_limit: 128m
    cpus: 0.25
    networks:
      platform:
        aliases: [basestack-templatesadmin]
      docker-api-ro: {}

  launcher:
    restart: unless-stopped
    image: {{image "launcher"}}
    environment:
      # O launcher entra nas redes dos ambientes, onde um serviço ou addon
      # de um projeto pode chamar-se "database" ou "auth": fala com a
      # plataforma pelos nomes basestack-*, que os projetos não podem usar.
      LAUNCHER_DATABASE_URL: "postgres://launcher:{{.Secrets.LauncherDBPassword}}@basestack-database:5432/app?sslmode=disable"
      AUTH_SERVICE_URL: "http://basestack-auth:8080"
      AUTH_ISSUER: "auth.base-stack.local"
      AUTH_AUDIENCE: "base-stack"
      TEMPLATESADMIN_SERVICE_URL: "http://basestack-templatesadmin:8093"
      SECRETSADMIN_SERVICE_URL: "http://basestack-secretsadmin:8092"
      LAUNCHER_SELF_URL: "http://basestack-launcher:8094"
      AUTOSCALER_GROUP_IMAGE: "{{image "autoscaler-group"}}"
      PUBLIC_BASE_DOMAIN: "{{.Domain}}"
      PUBLIC_TLS_CERT_RESOLVER: "{{.TLSCertResolver}}"
      LAUNCHER_TRAEFIK_DYNAMIC_DIR: /etc/traefik/dynamic
      TRAEFIK_CONTAINER: basestack-traefik
      LAUNCHER_PROMETHEUS_CONTAINER: basestack-prometheus
      GRAFANA_URL: "http://basestack-grafana:3000/grafana"
      GRAFANA_ADMIN_USER: admin
      GRAFANA_ADMIN_PASSWORD: "{{.Secrets.GrafanaAdminPassword}}"
      LAUNCHER_TERMINAL_ORIGINS: "{{.TerminalOrigins}}"
      LAUNCHER_SECRETS_KEY: "{{.Secrets.LauncherSecretsKey}}"
      # Registry da plataforma: o launcher emite os tokens e busca as
      # imagens de lá com a credencial interna.
      LAUNCHER_REGISTRY_HOST: "{{.RegistryHost}}"
      LAUNCHER_REGISTRY_TOKEN_KEY: /etc/base-stack/registry/token.key
      LAUNCHER_REGISTRY_TOKEN_CERT: /etc/base-stack/registry/token.crt
      LAUNCHER_REGISTRY_PULL_PASSWORD: "{{.Secrets.RegistryPullPassword}}"
      LAUNCHER_REGISTRY_URL: http://basestack-registry:5000
      # Nós remotos: os agentes ligam-se por https://api.<domínio>/v1/agent.
      LAUNCHER_CA_CERT: /etc/base-stack/ca.crt
      LAUNCHER_PUBLIC_API_URL: "https://api.{{.Domain}}"
      LAUNCHER_AGENT_IMAGE: "{{.RegistryHost}}/basestack/agent:{{.Version}}"
      # Cluster: swarm + redes overlay entre os nós (basestack set cluster on).
      # O portal: a página onde se autoriza o login da CLI pelo browser.
      LAUNCHER_PORTAL_URL: "{{.PortalURL}}"
      LAUNCHER_CLUSTER: "{{.Cluster}}"
      LAUNCHER_ADVERTISE_ADDR: "{{.AdvertiseAddr}}"
      # Sem HTTPS automático, o certificado da CA da instalação para a api
      # e o registry; com ele, valem os do Let's Encrypt (um certificado
      # fixo aqui ganhava-lhes).
      LAUNCHER_TRAEFIK_CERTIFICATES: "{{if not .TLSCertResolver}}/etc/traefik/tls/{{.TLS.RegistryCert}}:/etc/traefik/tls/{{.TLS.RegistryKey}}{{end}}"
      # O storage da plataforma: cada dump dos addons ganha lá uma cópia.
      LAUNCHER_BACKUP_STORAGE_URL: https://basestack-storage:8443
      LAUNCHER_BACKUP_STORAGE_ACCESS_KEY: "{{.Secrets.StorageAccessKey}}"
      LAUNCHER_BACKUP_STORAGE_SECRET_KEY: "{{.Secrets.StorageSecretKey}}"
      LAUNCHER_BACKUP_STORAGE_CA: /etc/base-stack/ca.crt
{{- with .BackupTarget}}
      # A cópia fora desta máquina, cifrada com a chave pública de backup.
      LAUNCHER_BACKUP_TARGET_URL: "{{.URL}}"
      LAUNCHER_BACKUP_TARGET_BUCKET: "{{.Bucket}}"
      LAUNCHER_BACKUP_TARGET_REGION: "{{.Region}}"
      LAUNCHER_BACKUP_TARGET_PREFIX: "{{.Prefix}}"
      LAUNCHER_BACKUP_TARGET_ACCESS_KEY: "{{.AccessKey}}"
      LAUNCHER_BACKUP_TARGET_SECRET_KEY: "{{.SecretKey}}"
      LAUNCHER_BACKUP_RECIPIENT: "{{$.BackupRecipient}}"
{{- end}}
    labels:
      base-stack.managed: "true"
      # A API de plataforma (CLI bs, CI) em api.<domínio> -- só /v1/projects
      # e /v1/cli (login da CLI pelo browser).
      traefik.enable: "true"
      traefik.docker.network: basestack-platform
      traefik.http.routers.platform-api.rule: "Host(`api.{{.Domain}}`) && (PathPrefix(`/v1/projects`) || PathPrefix(`/v1/cli`))"
      traefik.http.routers.platform-api.entrypoints: web
      traefik.http.routers.platform-api.service: platform-api
      traefik.http.routers.platform-api-tls.rule: "Host(`api.{{.Domain}}`) && (PathPrefix(`/v1/projects`) || PathPrefix(`/v1/cli`))"
      traefik.http.routers.platform-api-tls.entrypoints: websecure
      traefik.http.routers.platform-api-tls.service: platform-api
      traefik.http.routers.platform-api-tls.tls: "true"
      traefik.http.routers.platform-api-tls.tls.certresolver: "{{.TLSCertResolver}}"
{{- if .TLSCertResolver}}
      # HSTS: o browser passa a usar só HTTPS neste nome (6 meses).
      traefik.http.middlewares.bs-hsts-api.headers.stsSeconds: "15552000"
{{- end}}
{{- if .TLSCertResolver}}
      traefik.http.routers.platform-api-tls.middlewares: bs-hsts-api
{{- end}}
      traefik.http.services.platform-api.loadbalancer.server.port: "8094"
      # registry.<domínio>/token -> o servidor de tokens do registry.
      traefik.http.routers.registry-token.rule: "Host(`{{.RegistryHost}}`) && Path(`/token`)"
      traefik.http.routers.registry-token.entrypoints: websecure
      traefik.http.routers.registry-token.service: platform-api
      traefik.http.routers.registry-token.middlewares: "registry-token-path{{if .TLSCertResolver}},bs-hsts-api{{end}}"
      traefik.http.routers.registry-token.tls: "true"
      traefik.http.routers.registry-token.tls.certresolver: "{{.TLSCertResolver}}"
      traefik.http.middlewares.registry-token-path.replacepath.path: /v1/registry/token
      # Os agentes dos nós remotos: só por HTTPS (o túnel leva o controlo
      # do Docker do nó).
      traefik.http.routers.platform-agent.rule: "Host(`api.{{.Domain}}`) && PathPrefix(`/v1/agent`)"
      traefik.http.routers.platform-agent.entrypoints: websecure
      traefik.http.routers.platform-agent.service: platform-api
      traefik.http.routers.platform-agent.tls: "true"
      traefik.http.routers.platform-agent.tls.certresolver: "{{.TLSCertResolver}}"
{{- if .TLSCertResolver}}
      traefik.http.routers.platform-agent.middlewares: bs-hsts-api
{{- end}}
    volumes:
      # O único serviço com o socket do Docker direto: é quem cria os
      # containers dos projetos.
      - /var/run/docker.sock:/var/run/docker.sock
      - traefik-dynamic:/etc/traefik/dynamic
      - ./config/dashboards:/etc/base-stack/dashboards:ro
      - ./tls/token.key:/etc/base-stack/registry/token.key:ro
      - ./tls/ca.crt:/etc/base-stack/ca.crt:ro
      - ./tls/token.crt:/etc/base-stack/registry/token.crt:ro
    depends_on:
      database:
        condition: service_healthy
      storage:
        condition: service_healthy
    mem_limit: 128m
    cpus: 0.25
    networks:
      platform:
        aliases: [basestack-launcher]
      grafana: {}
    stop_grace_period: 20s

  portal:
    restart: unless-stopped
    image: {{image "portal"}}
    environment:
      AUTH_SERVICE_URL: "http://auth:8080"
      DBADMIN_SERVICE_URL: "http://database:8091"
      SECRETSADMIN_SERVICE_URL: "http://secretsadmin:8092"
      TEMPLATESADMIN_SERVICE_URL: "http://templatesadmin:8093"
      LAUNCHER_SERVICE_URL: "http://launcher:8094"
      GRAFANA_INTERNAL_URL: "http://basestack-grafana:3000"
      # Escutar em todas as interfaces: o portal está em duas redes, e a
      # porta publicada pode chegar por qualquer uma (ver o Dockerfile).
      HOSTNAME: "0.0.0.0"
    labels:
      base-stack.managed: "true"
      # portal.<domínio> pelo Traefik, para entrar de outras máquinas (e
      # com HTTPS quando há ACME); a porta publicada fica para esta máquina.
      traefik.enable: "true"
      traefik.docker.network: basestack-platform
      traefik.http.routers.portal.rule: "Host(`portal.{{.Domain}}`)"
      traefik.http.routers.portal.entrypoints: web
      traefik.http.routers.portal.service: portal
      traefik.http.routers.portal-tls.rule: "Host(`portal.{{.Domain}}`)"
      traefik.http.routers.portal-tls.entrypoints: websecure
      traefik.http.routers.portal-tls.service: portal
      traefik.http.routers.portal-tls.tls: "true"
      traefik.http.routers.portal-tls.tls.certresolver: "{{.TLSCertResolver}}"
{{- if .TLSCertResolver}}
      # HSTS: o browser passa a usar só HTTPS neste nome (6 meses).
      traefik.http.middlewares.bs-hsts-portal.headers.stsSeconds: "15552000"
{{- end}}
{{- if .TLSCertResolver}}
      traefik.http.routers.portal-tls.middlewares: bs-hsts-portal
{{- end}}
      traefik.http.services.portal.loadbalancer.server.port: "3000"
    ports:
      - "{{.PortalPort}}:3000"
    depends_on:
      - auth
      - database
      - secretsadmin
      - templatesadmin
      - launcher
    mem_limit: 256m
    cpus: 0.5
    networks:
      - platform
      - grafana

  # Registry de imagens da plataforma em registry.<domínio> (HTTPS pelo
  # Traefik). Quem pode enviar/buscar decide o launcher (tokens por
  # projeto: <registry>/<projeto>/<imagem>).
  registry:
    restart: unless-stopped
    image: registry:2.8.3
    environment:
      REGISTRY_AUTH: token
      REGISTRY_AUTH_TOKEN_REALM: "https://{{.RegistryHost}}/token"
      REGISTRY_AUTH_TOKEN_SERVICE: "{{.RegistryHost}}"
      REGISTRY_AUTH_TOKEN_ISSUER: base-stack
      REGISTRY_AUTH_TOKEN_ROOTCERTBUNDLE: /etc/base-stack/registry/token.crt
      REGISTRY_HTTP_SECRET: "{{.Secrets.RegistryHTTPSecret}}"
      # Atrás do Traefik: URLs relativas, para não anunciar http://.
      REGISTRY_HTTP_RELATIVEURLS: "true"
      REGISTRY_STORAGE_DELETE_ENABLED: "true"
    labels:
      base-stack.managed: "true"
      traefik.enable: "true"
      traefik.docker.network: basestack-platform
      traefik.http.routers.registry.rule: "Host(`{{.RegistryHost}}`)"
      traefik.http.routers.registry.entrypoints: websecure
      traefik.http.routers.registry.service: registry
      traefik.http.routers.registry.tls: "true"
      traefik.http.routers.registry.tls.certresolver: "{{.TLSCertResolver}}"
{{- if .TLSCertResolver}}
      # HSTS: o browser passa a usar só HTTPS neste nome (6 meses).
      traefik.http.middlewares.bs-hsts-registry.headers.stsSeconds: "15552000"
{{- end}}
{{- if .TLSCertResolver}}
      traefik.http.routers.registry.middlewares: bs-hsts-registry
{{- end}}
      traefik.http.services.registry.loadbalancer.server.port: "5000"
    volumes:
      - registry-data:/var/lib/registry
      - ./tls/token.crt:/etc/base-stack/registry/token.crt:ro
    mem_limit: 256m
    cpus: 0.5
    networks:
      platform:
        aliases: [basestack-registry]

  # --- Observabilidade ---

  prometheus:
    restart: unless-stopped
    image: prom/prometheus:latest
    # O launcher liga-o a cada rede de ambiente (métricas das apps).
    container_name: basestack-prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=6h
      # Só escuta na rede de observabilidade (o nome prometheus-obs só
      # existe lá): o launcher liga-o às redes dos projetos para recolher
      # métricas, e as apps não podem ler as dos outros projetos.
      - --web.listen-address=prometheus-obs:9090
    volumes:
      - ./config/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    depends_on:
      - docker-api-ro
    networks:
      observability:
        aliases: [prometheus-obs]
      docker-api-ro: {}
    mem_limit: 256m
    cpus: 0.5

  loki:
    restart: unless-stopped
    image: grafana/loki:latest
    command: -config.file=/etc/loki/loki-config.yml
    volumes:
      - ./config/loki-config.yml:/etc/loki/loki-config.yml:ro
      - loki-data:/loki
    networks:
      - observability
    mem_limit: 256m
    cpus: 0.5

  promtail:
    restart: unless-stopped
    image: grafana/promtail:latest
    command: -config.file=/etc/promtail/promtail-config.yml
    volumes:
      - ./config/promtail-config.yml:/etc/promtail/promtail-config.yml:ro
    networks:
      - observability
      - docker-api-ro
    depends_on:
      - loki
      - docker-api-ro
    mem_limit: 128m
    cpus: 0.3

  prom-label-proxy:
    restart: unless-stopped
    image: quay.io/prometheuscommunity/prom-label-proxy:v0.11.1
    command:
      - -label=project
      - -header-name=X-Project
      - -upstream=http://prometheus:9090
      - -insecure-listen-address=0.0.0.0:8080
      - -enable-label-apis
    depends_on:
      - prometheus
    networks:
      - observability
    mem_limit: 64m
    cpus: 0.25

  grafana:
    restart: unless-stopped
    image: grafana/grafana:latest
    container_name: basestack-grafana
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: "{{.Secrets.GrafanaAdminPassword}}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      # Entra-se pelo portal (/grafana), que diz ao Grafana quem é a conta.
      GF_AUTH_PROXY_ENABLED: "true"
      GF_AUTH_PROXY_HEADER_NAME: X-WEBAUTH-USER
      GF_AUTH_PROXY_HEADER_PROPERTY: username
      GF_AUTH_PROXY_HEADERS: "Email:X-WEBAUTH-EMAIL Name:X-WEBAUTH-NAME"
      GF_AUTH_PROXY_AUTO_SIGN_UP: "true"
      # A rede basestack-grafana sem o gateway (.1): pedidos vindos do host
      # não conseguem fingir ser outra conta.
      GF_AUTH_PROXY_WHITELIST: "172.31.251.2/31, 172.31.251.4/30, 172.31.251.8/29, 172.31.251.16/28, 172.31.251.32/27, 172.31.251.64/26, 172.31.251.128/25"
      GF_USERS_AUTO_ASSIGN_ORG: "true"
      GF_USERS_AUTO_ASSIGN_ORG_ID: "1"
      GF_USERS_AUTO_ASSIGN_ORG_ROLE: Viewer
      GF_SERVER_ROOT_URL: "{{.PortalURL}}/grafana/"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_LIVE_MAX_CONNECTIONS: "0"
    ports:
      # Acesso de emergência (admin), só a partir desta máquina.
      - "127.0.0.1:{{.GrafanaPort}}:3000"
    networks:
      - observability
      - grafana
    depends_on:
      - prometheus
      - loki
    mem_limit: 768m
    cpus: 0.5
