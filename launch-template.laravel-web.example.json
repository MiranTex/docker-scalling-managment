{
  "image": "sail-8.4/app",
  "env": [
    "WWWUSER=1000",
    "LARAVEL_SAIL=1",
    "XDEBUG_MODE=off",
    "XDEBUG_CONFIG=client_host=host.docker.internal",
    "IGNITION_LOCAL_SITES_PATH=/home/dev/javra_projects/polskamit-mitsui-laravel",
    "QUEUE_NAMES=*,invoice-generation"
  ],
  "binds": [
    "/home/dev/javra_projects/polskamit-mitsui-laravel:/var/www/html",
    "/home/dev/javra_projects/polskamit-mitsui-laravel/storage:/var/www/html/storage"
  ],
  "network": "polskamit-mitsui-laravel_sail",
  "extraHosts": ["host.docker.internal:host-gateway"]
}
