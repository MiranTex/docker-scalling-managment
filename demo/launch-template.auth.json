{
  "image": "auth-service:latest",
  "env": [
    "AUTH_DATABASE_URL=postgres://auth:auth@database:5432/app?sslmode=disable",
    "AUTH_ISSUER=auth.base-stack.local",
    "AUTH_AUDIENCE=base-stack",
    "LOG_FORMAT=json",
    "LOG_LEVEL=info"
  ],
  "binds": ["auth-signing-key:/var/lib/auth"],
  "network": "auth-net",
  "labels": {
    "base-stack.managed": "true"
  }
}
